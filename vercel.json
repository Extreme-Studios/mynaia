{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/handler?route=health" },
    { "source": "/api/gemini/status", "destination": "/api/handler?route=gemini-status" },
    { "source": "/api/tavus/status", "destination": "/api/handler?route=tavus-status" },
    { "source": "/api/memory/status", "destination": "/api/handler?route=memory-status" },
    { "source": "/api/dr-paws/subjects", "destination": "/api/handler?route=subjects" },
    { "source": "/api/dr-paws/subjects/:id/reset", "destination": "/api/handler?route=subject-reset&id=:id" },
    { "source": "/api/dr-paws/assessment", "destination": "/api/handler?route=assessment" },
    { "source": "/api/dr-paws/case", "destination": "/api/handler?route=case" },
    { "source": "/api/modes/status", "destination": "/api/handler?route=mode-status" },
    { "source": "/api/admin/tavus-profiles", "destination": "/api/handler?route=admin-profiles" },
    { "source": "/api/admin/tavus-profile", "destination": "/api/handler?route=admin-profile" },
    { "source": "/api/admin/tavus-profile/inspect", "destination": "/api/handler?route=admin-profile-inspect" },
    { "source": "/api/memory/sync", "destination": "/api/handler?route=memory-sync" },
    { "source": "/api/access/status", "destination": "/api/handler?route=access-status" },
    { "source": "/api/access/login", "destination": "/api/handler?route=access-login" },
    { "source": "/api/conversations", "destination": "/api/handler?route=conversations" },
    { "source": "/api/conversations/:id/end", "destination": "/api/handler?route=end&id=:id" },
    { "source": "/api/conversations/:id/status", "destination": "/api/handler?route=conversation-status&id=:id" },
    { "source": "/naia", "destination": "/index.html" },
    { "source": "/naya", "destination": "/index.html" },
    { "source": "/dr-paws", "destination": "/index.html" },
    { "source": "/dr-paws/dashboard", "destination": "/dashboard.html" },
    { "source": "/dr-paws/dashboard/subjects/:id", "destination": "/case.html" }
  ]
}
